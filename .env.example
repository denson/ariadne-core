# .env — not committed to version control
# Copy this file to .env and fill in your values

# Database (local development only — for docker compose)
# Railway users: skip this. Railway injects DATABASE_URL automatically.
DB_PASSWORD=pick-any-password

# API keys for embedding and vision (any OpenAI-compatible provider)
# These are the canonical ARIADNE_-prefixed names read by config.py.
# Unprefixed names (EMBEDDING_API_KEY, VISION_API_KEY, ...) also work for
# backward compatibility.
ARIADNE_EMBEDDING_API_KEY=your-provider-api-key
ARIADNE_EMBEDDING_MODEL=text-embedding-3-small
ARIADNE_EMBEDDING_BASE_URL=https://api.openai.com/v1

ARIADNE_IMAGE_ENRICHMENT_API_KEY=your-provider-api-key
ARIADNE_IMAGE_ENRICHMENT_MODEL=gpt-4o-mini
ARIADNE_IMAGE_ENRICHMENT_BASE_URL=https://api.openai.com/v1

# Client authentication — generate a strong secret
# Clients connect with this key via X-API-Key header
ARIADNE_API_KEY=generate-a-strong-secret

# Optional: override config file values
# ARIADNE_EMBEDDING_MODEL=bge-m3
# ARIADNE_IMAGE_ENRICHMENT_MODEL=gpt-4o
