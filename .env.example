# .env — not committed to version control
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=pick-any-password

# API keys for embedding and vision (any OpenAI-compatible provider)
EMBEDDING_API_KEY=your-provider-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

VISION_API_KEY=your-provider-api-key
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1

# Optional: override config file values
# ARIADNE_EMBEDDING_MODEL=bge-m3
# ARIADNE_IMAGE_ENRICHMENT_MODEL=gpt-4o
