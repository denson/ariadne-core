# Database (local development only -- for docker compose)
# Railway users: skip this. Railway injects DATABASE_URL automatically.
DB_PASSWORD=local-dev-only

# --- Embedding Provider ---
ARIADNE_EMBEDDING_API_KEY=<your api key here>
ARIADNE_EMBEDDING_MODEL=gemini-embedding-001
ARIADNE_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ARIADNE_EMBEDDING_DIMENSIONS=1536

# --- Vision Provider (for image descriptions in documents) ---
ARIADNE_IMAGE_ENRICHMENT_API_KEY=<your api key here>
ARIADNE_IMAGE_ENRICHMENT_MODEL=gemini-2.0-flash
ARIADNE_IMAGE_ENRICHMENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Auth (OAuth 2.1 via Auth0) ---
# Captured during Auth0 tenant setup (OAUTH_PLAN.md Pass 1). These are
# the Native `Ariadne CLI` application values — NOT secrets, safe to
# commit. Clients fetch these via GET /.well-known/ariadne-config.
AUTH0_DOMAIN=dev-1inpk4rtyzwxmcgm.us.auth0.com
AUTH0_CLIENT_ID=ixpErHZnMADzV7wTEcO48N3oaiNCjNUj
AUTH0_AUDIENCE=https://ariadne-core

# --- Upload signing secret (optional) ---
# Server-side HMAC key used to sign presigned upload URLs for
# /api/upload/signed. If unset, the presigned-upload endpoint returns
# 503 (the authenticated /api/upload endpoint is unaffected).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARIADNE_UPLOAD_SIGNING_SECRET=<generate with secrets.token_urlsafe(32)>


# --- Railway Deployment ---
ARIADNE_URL=https://your-deployment.up.railway.app
