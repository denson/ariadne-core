# .env — not committed to version control
# Copy this file to .env and fill in your values

# Database (local development only — for docker compose)
# Railway users: skip this. Railway injects DATABASE_URL automatically.
DB_PASSWORD=pick-any-password

# API keys for embedding and vision (any OpenAI-compatible provider)
EMBEDDING_API_KEY=your-provider-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

VISION_API_KEY=your-provider-api-key
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1

# Client authentication — generate a strong secret
# Clients connect with this key via X-API-Key header
ARIADNE_API_KEY=generate-a-strong-secret

# Optional: override config file values
# ARIADNE_EMBEDDING_MODEL=bge-m3
# ARIADNE_IMAGE_ENRICHMENT_MODEL=gpt-4o

# Railway deployment (saved by setup.py after deploy)
# Create a token at https://railway.com/account/tokens
# RAILWAY_TOKEN=your-railway-api-token
# RAILWAY_DEPLOY_URL=https://your-app.up.railway.app
