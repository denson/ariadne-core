{
  "name": "ariadne-document-intelligence",
  "version": "4.0.0",
  "description": "Process, search, and manage documents through Ariadne Core — a document extraction and retrieval pipeline that converts files into clean Markdown and searchable vector embeddings.",
  "author": "Denson Smith",
  "license": "Apache-2.0",
  "category": "integrations",
  "runtime": "any",
  "tags": [
    "document-processing",
    "retrieval",
    "search",
    "pdf",
    "mcp",
    "vector-embeddings",
    "knowledge-base",
    "rag"
  ],
  "supported_formats": [
    "pdf", "docx", "pptx", "xlsx", "xls", "csv", "tsv",
    "html", "txt", "md", "json", "xml", "rtf", "epub",
    "eml", "msg", "zip", "ipynb", "rst", "org",
    "wav", "mp3", "m4a",
    "jpg", "png", "gif"
  ],
  "requires": {
    "mcp_tools": [
      "convert_document",
      "search",
      "get_document",
      "list_documents",
      "list_collections",
      "ingest"
    ]
  },
  "compatible_clients": [
    "claude-desktop",
    "claude-cowork",
    "claude-code",
    "cursor",
    "openai-desktop",
    "gemini-desktop"
  ]
}
